.settings-panel {
    position: absolute;
    top: 5%;
    left: 5%;
    right: 5%;
    width: auto;
    height: 90%;
    max-height: 800px;
    background-color: rgba(0, 0, 0, 0.9);
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
}

.settings-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
}

.settings-title {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
}

.profile-controls {
    flex-direction: row;
    margin-bottom: 15px;
}

/* The profile dropdown and the search field share the row's spare width; the dropdown is capped. */
.profile-dropdown {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 120px;
    max-width: 320px;
}

.settings-search {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 140px;
    margin-left: 12px;
}

.profile-dirty-label {
    align-self: center;
    margin-left: 8px;
    margin-right: 8px;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(200, 120, 30, 0.35);
    border-width: 1px;
    border-color: rgb(220, 140, 40);
    color: rgb(255, 210, 150);
    font-size: 12px;
    -unity-font-style: italic;
}

.profile-button {
    padding: 5px 10px;
    background-color: rgb(50, 50, 50);
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 5px;
    color: white;
}

.profile-button:hover {
    background-color: rgb(70, 70, 70);
}

.profile-button:active {
    background-color: rgb(30, 30, 30);
}

.settings-scroll {
    flex-grow: 1;
}

.settings-group {
    margin-bottom: 20px;
    padding: 10px;
    background-color: rgba(40, 40, 40, 0.5);
    border-radius: 5px;
}

.group-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(100, 100, 100);
}

.group-header:hover .group-title,
.group-header:hover .group-chevron {
    color: white;
}

.group-chevron {
    width: 18px;
    font-size: 12px;
    color: rgb(160, 160, 160);
    -unity-text-align: middle-center;
    margin-right: 4px;
}

.group-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
}

/* Collapsed group: header only, no divider or gap under it. */
.settings-group.collapsed {
    margin-bottom: 8px;
}

.settings-group.collapsed .group-header {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom-width: 0;
}

.settings-group.collapsed .group-content {
    display: none;
}

/* Rows hidden by a ShowRowIf condition or by the search filter. */
.condition-hidden,
.search-hidden {
    display: none;
}

.search-empty-label {
    color: rgb(160, 160, 160);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    margin-top: 20px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    min-height: 25px;
}

.setting-label {
    flex-grow: 1;
    color: white;
    font-size: 14px;
    min-width: 200px;
}

.setting-input {
    min-width: 200px;
    max-width: 300px;
}

.toggle {
    min-width: 20px;
}

.curve-thumbnail {
    min-width: 200px;
    max-width: 300px;
    height: 25px;
    background-color: rgba(34, 34, 34, 1);
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 3px;
    cursor: link;
}

.curve-thumbnail:hover {
    border-color: rgb(120, 120, 120);
    background-color: rgba(44, 44, 44, 1);
}

/* Color swatch / gradient strip: a CPU-rendered background image, click to edit */
.color-swatch,
.gradient-thumbnail {
    min-width: 200px;
    max-width: 300px;
    height: 25px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 3px;
    background-color: rgb(34, 34, 34);
    -unity-background-scale-mode: stretch-to-fill;
    cursor: link;
}

.color-swatch:hover,
.gradient-thumbnail:hover {
    border-color: rgb(170, 170, 170);
}

/* Inside an array the swatch shares the row with the remove button */
.array-element-input.color-swatch,
.array-element-input.gradient-thumbnail {
    min-width: 0;
}

/* The editor's centeredGreyMiniLabel */
.hdr-badge {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 3px;
    font-size: 10px;
    -unity-text-align: middle-center;
    color: rgb(128, 128, 128);
    padding: 0;
    margin: 0;
}

.close-button {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 30px;
    height: 30px;
    background-color: rgb(200, 50, 50);
    border-width: 0;
    border-radius: 15px;
    font-size: 16px;
    color: white;
}

.close-button:hover {
    background-color: rgb(220, 70, 70);
}

.array-row-subcontainer {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
}

.array-container {
    flex-direction: column;
    margin-top: 5px;
    margin-right: 5px;
    padding: 5px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 3px;
    background-color: rgba(20, 20, 20, 0.5);
    min-width: 210px;
    max-width: 300px;
}

.array-element {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.array-element-input {
    flex-grow: 1;
    margin-right: 5px;
}

.array-button {
    width: auto;
    height: 25px;
    background-color: rgb(80, 80, 80);
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    border-radius: 3px;
    color: white;
    font-size: 12px;
    padding: 2px 8px;
}

.array-button:hover {
    background-color: rgb(100, 100, 100);
}

.array-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.array-collapse-button {
    width: 20px;
    height: 20px;
    background-color: rgb(60, 60, 60);
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    border-radius: 3px;
    color: white;
    font-size: 12px;
    margin-right: 8px;
    padding: 0;
    flex-shrink: 0;
}

.array-collapse-button:hover {
    background-color: rgb(80, 80, 80);
}

.array-count-label {
    color: rgb(180, 180, 180);
    font-size: 12px;
    margin-right: 10px;
    flex-shrink: 0;
}

.array-content {
    flex-direction: column;
}

.array-content.collapsed {
    display: none;
}

.hidden {
    display: none;
}

.tab-container {
    flex-direction: row;
    margin-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
    padding-bottom: 10px;
}

.tab-button {
    padding: 10px 20px;
    background-color: rgb(40, 40, 40);
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 5px 5px 0 0;
    color: rgb(180, 180, 180);
    margin-right: 5px;
}

.tab-button:hover {
    background-color: rgb(60, 60, 60);
    color: white;
}

.tab-button.active {
    background-color: rgb(80, 80, 80);
    color: white;
    border-bottom-color: rgb(80, 80, 80);
}

.tab-content {
    flex-grow: 1;
}

.tab-panel {
    display: none;
}

.tab-panel.active {
    display: flex;
    flex-direction: column;
}
.setting-tooltip {
    position: absolute;
    max-width: 360px;
    padding: 6px 10px;
    background-color: rgba(20, 20, 20, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    color: white;
    font-size: 12px;
    white-space: normal;
}

/* Post Processing tab: which look (particle layer / camera feed) the controls below edit. */
.pp-target-controls {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.pp-target-label {
    color: rgb(180, 180, 180);
    margin-right: 8px;
}

.pp-target-button {
    padding: 6px 14px;
    background-color: rgb(40, 40, 40);
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 4px;
    color: rgb(180, 180, 180);
    margin-right: 5px;
}

.pp-target-button:hover {
    background-color: rgb(60, 60, 60);
    color: white;
}

.pp-target-button.active {
    background-color: rgb(80, 80, 80);
    border-color: rgb(140, 140, 140);
    color: white;
}
