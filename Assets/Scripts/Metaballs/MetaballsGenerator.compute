#pragma kernel MetaballFieldGenerator
#pragma kernel MetaballSdfGenerator

uint3 Dims;                               // Grid dimensions
float Scale;                              // World size of one voxel
float Isovalue;                           // Marching-cubes target value (SDF kernel only)
float MaxExtent;                          // Largest world dimension of the volume (SDF normaliser)
RWStructuredBuffer<float> Voxels;         // Scalar field output (mesh path)
RWTexture3D<float> Sdf;                   // Signed distance output (VFX path)
StructuredBuffer<float3> MetaballCenters; // Buffer of metaball centers
StructuredBuffer<float> MetaballRadii;    // Buffer of metaball radii

float3 VoxelToLocal(uint3 id)
{
    return Scale * (id + 0.5 - Dims / 2);
}

// Field value as before: sum of squared linear falloffs.
[numthreads(8, 8, 8)]
void MetaballFieldGenerator(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= Dims)) return;

    float3 p = VoxelToLocal(id);
    float value = 0.0;

    for (uint i = 0; i < MetaballCenters.Length; i++)
    {
        float3 center = MetaballCenters[i];
        float radius = MetaballRadii[i];
        float distance = length(p - center);
        if (distance < radius)
        {
            float influence = (radius - distance) / radius;
            value += influence * influence;
        }
    }

    Voxels[id.x + Dims.x * (id.y + Dims.y * id.z)] = value;
}

// Direct signed distance to the Isovalue isosurface of the field above, in the
// same units MeshToSDFBaker produces: distance / MaxExtent, negative inside.
//
// Near the surface we take one Newton step on the field, (iso - f) / |grad f|,
// which is exact on the isosurface itself. Outside every ball's influence the
// field and its gradient are both zero, so we fall back to the distance to the
// nearest single-ball isosphere (radius r * (1 - sqrt(iso))). That fallback is
// an upper bound outside the blob, so min() with it also caps the Newton
// estimate where the gradient fades and keeps the field monotonic outward.
[numthreads(8, 8, 8)]
void MetaballSdfGenerator(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= Dims)) return;

    float3 p = VoxelToLocal(id);
    float value = 0.0;
    float3 grad = 0.0;
    float unionDist = 1e6;
    float maxRadius = 0.0;
    float isoRoot = sqrt(Isovalue);

    for (uint i = 0; i < MetaballCenters.Length; i++)
    {
        float radius = MetaballRadii[i];
        if (radius <= 0.0) continue;

        float3 diff = p - MetaballCenters[i];
        float distance = length(diff);
        maxRadius = max(maxRadius, radius);
        unionDist = min(unionDist, distance - radius * (1.0 - isoRoot));

        if (distance < radius)
        {
            float s = (radius - distance) / radius;
            value += s * s;
            // d/dp of s^2 = 2 s * d/dp((r - |p - c|) / r) = -2 s (p - c) / (r |p - c|)
            grad -= (2.0 * s / (radius * max(distance, 1e-5))) * diff;
        }
    }

    float dist;
    if (value <= 0.0)
    {
        // Outside every influence radius (or no active metaballs at all).
        dist = min(unionDist, 4.0 * MaxExtent);
    }
    else
    {
        float newton = (Isovalue - value) / max(length(grad), 1e-6);
        dist = newton >= 0.0 ? min(newton, unionDist) : max(newton, -maxRadius);
    }

    Sdf[id] = dist / MaxExtent;
}
